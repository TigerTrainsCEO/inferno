  "authors": ["Inferno Client"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.infernoclient.InfernoClient"]
  },
  "mixins": ["inferno_client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
